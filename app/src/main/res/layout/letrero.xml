<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9C2A3"
    tools:context=".letrero">

    <androidx.cardview.widget.CardView
        android:id="@+id/tarjeta"
        android:layout_width="50mm"
        android:layout_height="35mm"
        app:cardBackgroundColor="#430D06"
        app:cardCornerRadius="25dp"
        app:cardElevation="40dp"
        app:layout_constraintBottom_toTopOf="@+id/regresar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/tarjeta2.0"
                android:layout_width="40mm"
                android:layout_height="25mm"
                android:layout_gravity="center"
                app:cardBackgroundColor="#541C0A"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/pedido"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Pedido realizado"
                    android:textColor="@color/white"
                    android:textSize="50dp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/regresar"
        android:layout_width="35mm"
        android:layout_height="10mm"
        android:layout_marginBottom="60dp"
        android:text="FINALIZAR"
        android:textSize="25dp"
        android:textStyle="italic"
        android:backgroundTint="#8A4932"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
